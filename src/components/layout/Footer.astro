---
import { Mail, MapPin, Clock, ArrowUpRight } from 'lucide-astro';
import { withBase } from '../../utils/paths';

const servicios = [
  { label: 'Asesoría Financiera', href: withBase('soluciones/#asesoria') },
  { label: 'Planeación Tributaria', href: withBase('soluciones/#tributaria') },
  { label: 'Automatización Contable', href: withBase('soluciones/#automatizacion') },
  { label: 'Inteligencia de Datos', href: withBase('soluciones/#datos') },
];

const empresa = [
  { label: 'Metodología', href: withBase('metodologia/') },
  { label: 'Recursos', href: withBase('recursos/') },
  { label: 'Contacto', href: withBase('contacto/') },
];

const contactoHref = withBase('contacto/');
---
<footer class="bg-gray-800 text-white pt-20 pb-8">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      <!-- Marca -->
      <div>
        <p class="text-2xl font-bold font-display text-white mb-4">TAC ADVISORS</p>
        <p class="text-sm text-gray-400 leading-relaxed mb-6">
          Una nueva forma de abordar la gestión contable y financiera, con visión estratégica,
          apoyo tecnológico e inteligencia aplicada.
        </p>
        <div class="flex flex-col gap-3">
          <div class="flex items-center gap-2 text-sm text-gray-400">
            <Mail size={14} stroke-width={2} class="text-accent shrink-0" />
            <span>contacto@tacadvisors.co</span>
          </div>
          <div class="flex items-center gap-2 text-sm text-gray-400">
            <MapPin size={14} stroke-width={2} class="text-accent shrink-0" />
            <span>Bogotá, Colombia</span>
          </div>
          <div class="flex items-center gap-2 text-sm text-gray-400">
            <Clock size={14} stroke-width={2} class="text-accent shrink-0" />
            <span>Lun – Vie: 8:00 – 18:00</span>
          </div>
        </div>
        <nav class="flex items-center gap-3 mt-6" aria-label="Redes sociales">
          <a
            href="https://www.instagram.com/tacadvisorssas/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="TAC Advisors en Instagram"
            class="flex items-center justify-center size-10 rounded-lg border border-gray-700 text-gray-400 hover:border-accent hover:bg-accent/10 hover:text-accent transition-colors duration-300"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="20" x="2" y="2" rx="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37Z" />
              <path d="M17.5 6.5h.01" />
            </svg>
          </a>
          <a
            href="https://www.facebook.com/share/18bQtZWL3w/?mibextid=wwXIfr"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="TAC Advisors en Facebook"
            class="flex items-center justify-center size-10 rounded-lg border border-gray-700 text-gray-400 hover:border-accent hover:bg-accent/10 hover:text-accent transition-colors duration-300"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="currentColor">
              <path d="M13.5 22V12.9h3.05l.46-3.55H13.5V7.08c0-1.03.29-1.73 1.76-1.73h1.88V2.18A25.17 25.17 0 0 0 14.4 2c-2.71 0-4.57 1.66-4.57 4.72v2.63H6.76v3.55h3.07V22h3.67Z" />
            </svg>
          </a>
          <a
            href="https://www.threads.com/@tacadvisorssas"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="TAC Advisors en Threads"
            class="flex items-center justify-center size-10 rounded-lg border border-gray-700 text-gray-400 hover:border-accent hover:bg-accent/10 hover:text-accent transition-colors duration-300"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12.2 21.5c-5.3 0-8.4-3.55-8.4-9.48 0-5.96 3.05-9.52 8.25-9.52 4.08 0 6.78 2.22 7.53 6.08" />
              <path d="M7.7 9.52c1.17-.68 2.67-1.03 4.29-1.03 4.86 0 7.77 2.01 7.77 5.41 0 2.75-2.15 4.65-5.15 4.65-2.78 0-4.55-1.53-4.55-3.7 0-2.1 1.82-3.43 4.68-3.43 1.81 0 3.69.51 5.22 1.49" />
            </svg>
          </a>
        </nav>
      </div>

      <!-- Servicios -->
      <div>
        <h3 class="text-base font-semibold text-white mb-4">Servicios</h3>
        <ul class="space-y-3">
          {servicios.map(({ label, href }) => (
            <li>
              <a href={href} class="text-sm text-gray-400 hover:text-accent transition-colors duration-300 inline-flex items-center gap-1 group">
                {label}
                <ArrowUpRight size={12} class="opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Empresa -->
      <div>
        <h3 class="text-base font-semibold text-white mb-4">Empresa</h3>
        <ul class="space-y-3">
          {empresa.map(({ label, href }) => (
            <li>
              <a href={href} class="text-sm text-gray-400 hover:text-accent transition-colors duration-300 inline-flex items-center gap-1 group">
                {label}
                <ArrowUpRight size={12} class="opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- CTA rápido -->
      <div>
        <h3 class="text-base font-semibold text-white mb-4">¿Listo para empezar?</h3>
        <p class="text-sm text-gray-400 leading-relaxed mb-6">
          Agende una consulta técnica gratuita y descubra cómo optimizar su operación financiera.
        </p>
        <a
          href={contactoHref}
          data-cal-link="tacadvisors/30min"
        data-cal-namespace="30min"
        data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}'
          class="inline-flex items-center justify-center gap-2
                 bg-gradient-to-br from-accent to-accent-hover
                 text-white text-sm font-semibold px-5 py-2.5 rounded-lg
                 transition-all duration-300
                 hover:-translate-y-0.5 hover:shadow-[0_8px_16px_rgba(0,212,170,0.3)]"
        >
          Consulta Gratuita
        </a>
      </div>
    </div>

    <!-- Línea divisoria con gradiente -->
    <div class="h-px bg-gradient-to-r from-transparent via-gray-600 to-transparent mb-8" />

    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-gray-500">
      <p>&copy; 2026 TAC ADVISORS SAS. Todos los derechos reservados.</p>
      <p class="flex items-center gap-1">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent animate-pulse-soft" />
        Sistemas operativos
      </p>
    </div>
  </div>
</footer>
