---
import ServicioDetailLayout from '../../layouts/ServicioDetailLayout.astro';
---

<ServicioDetailLayout
  titulo="Análisis"
  tituloItalico="Financiero."
  subtitulo="Análisis Financiero Estratégico"
  badgeLabel="Financial Intelligence // V2.0"
  descripcionCorta="Transformamos datos financieros en proyecciones accionables y escenarios de negocio para líderes que toman decisiones con fundamento."
  imagen="https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?w=700&h=500&fit=crop&q=80"
  imgAlt="Gráficos financieros y análisis de datos en pantalla moderna"
  color="primary"
  heroQuote={{
    label: 'CORE_VALUE_PROPOSITION',
    text: 'Los números cuentan una historia. Nuestra función es asegurarse de que usted la entienda antes de que sea demasiado tarde.',
  }}
  intro="Nuestro servicio de análisis financiero va más allá de la interpretación de estados financieros: construimos modelos que transforman información histórica en proyecciones accionables y escenarios de negocio para líderes que toman decisiones con fundamento, no con intuición."
  enQueConsiste={[
    'Combinamos técnicas de análisis cuantitativo, herramientas de modelado predictivo y conocimiento profundo del entorno empresarial colombiano para entregar insights que directamente impactan la rentabilidad y el posicionamiento competitivo de su organización.',
    'Cada análisis se diseña a la medida de su negocio, con benchmark sectorial, alertas tempranas y recomendaciones estratégicas que puede implementar de forma inmediata.',
  ]}
  queIncluye={[
    { titulo: 'Diagnóstico integral de salud financiera', descripcion: 'Evaluación profunda de rentabilidad, solvencia, liquidez y eficiencia operativa con comparativos sectoriales.' },
    { titulo: 'Modelado de escenarios y proyecciones', descripcion: 'Simulación de escenarios optimistas, pesimistas y base para evaluar impactos de decisiones estratégicas.' },
    { titulo: 'Análisis de rentabilidad por línea de negocio', descripcion: 'Segmentación de márgenes por producto, servicio o unidad de negocio para identificar oportunidades.' },
    { titulo: 'Evaluación de estructura de capital', descripcion: 'Análisis de deuda, equity y costo de capital para optimizar la composición financiera de la empresa.' },
    { titulo: 'Valoración de proyectos de inversión', descripcion: 'Modelos DCF y análisis de retorno ajustado por riesgo para fundamentar decisiones de inversión.' },
    { titulo: 'Dashboard ejecutivo personalizado', descripcion: 'Reportes automatizados con KPIs financieros clave para seguimiento en tiempo real.' },
  ]}
  beneficios={[
    { titulo: 'Decisiones con fundamento', descripcion: 'Recomendaciones estratégicas respaldadas en análisis cuantitativos, no en corazonadas ni tendencias generales.' },
    { titulo: 'Visibilidad anticipada', descripcion: 'Identificación proactiva de riesgos financieros y oportunidades antes de que se conviertan en problemas.' },
    { titulo: 'Optimización de márgenes', descripcion: 'Análisis detallado que revela dónde se está dejando de ganar y dónde es posible mejorar.' },
    { titulo: 'Credibilidad con terceros', descripcion: 'Información financiera de calidad que facilita acceso a financiamiento e inversionistas.' },
  ]}
  paraQuien={[
    { texto: 'Empresarios y directivos que necesitan claridad sobre la verdadera salud financiera de su organización.' },
    { texto: 'Gerentes que toman decisiones de inversión y requieren fundamentación cuantitativa sólida.' },
    { texto: 'Compañías en proceso de expansión que necesitan modelar el impacto financiero del crecimiento.' },
    { texto: 'Startups y PyMEs que buscan profesionalizar su gestión con indicadores y métricas claras.' },
  ]}
  enfoque={[]}
  enfoqueBar={{ human: 'Human Expertise 60%', tech: 'Tech Automation 40%' }}
  ctaTitulo="Transforme sus datos en ventajas competitivas"
  ctaDescripcion="Solicite un diagnóstico financiero integral y descubra cómo convertir sus números en decisiones estratégicas con impacto real."
  ctaBtnPrimario="Solicitar diagnóstico"
  ctaBtnSecundario="Hablar con un asesor"
/>
