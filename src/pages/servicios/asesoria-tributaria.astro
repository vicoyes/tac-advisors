    { titulo: 'Acompañamiento ante la DIAN', descripcion: 'Representación y defensa en casos de requerimiento,视察 o proceso de determinación oficial.' },
    { titulo: 'Actualización sobre reformas tributarias', descripcion: 'Comunicación proactiva sobre cambios normativos que impactan su sector o tipo de empresa.' },
    { titulo: 'Modelado de impactos por decisiones', descripcion: 'Evaluación tributaria anticipada para inversiones, reestructuraciones o cambios en la operación.' },
  ]}
  beneficios={[
    { titulo: 'Protección patrimonial', descripcion: 'Minimización de riesgos de sanciones, intereses y costas derivadas de errores o inconsistencias.' },
