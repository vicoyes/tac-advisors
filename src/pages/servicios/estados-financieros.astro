    { titulo: 'Notas a los estados financieros', descripcion: 'Revelaciones complementarias sobre políticas contables, estimaciones y contingencias.' },
    { titulo: 'Interpretación y análisis ejecutivo', descripcion: 'Narrativa gerencial que explica resultados, identifica tendencias y alerta sobre riesgos u oportunidades.' },
