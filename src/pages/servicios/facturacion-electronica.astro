---
import ServicioDetailLayout from '../../layouts/ServicioDetailLayout.astro';
---

<ServicioDetailLayout
  titulo="Facturación"
  tituloItalico="Electrónica."
  subtitulo="Facturación Electrónica e Integración DIAN"
  badgeLabel="Electronic Invoicing // V2.0"
  descripcionCorta="Conectividad normativa que impulsa su operación: implementación completa de su ecosistema de facturación electrónica con la DIAN."
  imagen="https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=700&h=500&fit=crop&q=80"
  imgAlt="Facturación electrónica y documentos digitales en ambiente tecnológico moderno"
  color="accent"
  heroQuote={{
    label: 'CORE_VALUE_PROPOSITION',
    text: 'La facturación electrónica bien implementada no es una carga operativa: es la columna vertebral de su comercio digital.',
  }}
  intro="La facturación electrónica no es solo un mandato de la DIAN: es una oportunidad para digitalizar su ciclo comercial, reducir errores manuales y ganar velocidad en sus transacciones."
  enQueConsiste={[
    'Implementamos soluciones integrales que conectan sus sistemas con la plataforma de facturación electrónica de la DIAN, garantizando emisión, transmisión, validación y almacenamiento con total conformidad regulatoria.',
    'Nuestro servicio incluye configuración completa, integración con sistemas ERP o contables, y monitoreo continuo para asegurar que todas sus transacciones sean aceptadas sin rechazos ni contingencias.',
  ]}
  queIncluye={[
    { titulo: 'Configuración de documentos electrónicos', descripcion: 'Habilitación completa de facturas, notas crédito, notas débito y documentos soporte según su operación.' },
    { titulo: 'Integración con sistemas ERP y contables', descripcion: 'Conexión entre su plataforma de facturación y sistemas de inventario, ventas y contabilidad.' },
    { titulo: 'Gestión del ciclo de validación DIAN', descripcion: 'Monitoreo de aceptación en tiempo real con resolución inmediata de rechazos para evitar bloqueos.' },
    { titulo: 'Administración de contingencias', descripcion: 'Protocolos de contingencia cuando la DIAN presente indisponibilidad, asegurando continuidad operativa.' },
    { titulo: 'Catálogo de productos y servicios', descripcion: 'Configuración de ítems con clasificación tributaria correcta para garantizar validez de documentos.' },
    { titulo: 'Archivo y retención documental', descripcion: 'Gestión del almacenamiento normativo de documentos electrónicos con disponibilidad para auditorías.' },
  ]}
  beneficios={[
    { titulo: 'Operación sin fricciones', descripcion: 'Emisión de documentos electrónicos sin errores, sin reprocesos y sin bloqueos por rechazo de la DIAN.' },
    { titulo: 'Reducción de costos operativos', descripcion: 'Eliminación de impresión, distribución física y gestión manual de documentos tributarios.' },
    { titulo: 'Cumplimiento normativo garantizado', descripcion: 'Documentación siempre válida y aceptada por la DIAN, protegida contra sanciones o glosas.' },
    { titulo: 'Información comercial en tiempo real', descripcion: 'Datos de ventas y facturación disponibles inmediatamente para análisis y toma de decisiones.' },
  ]}
  paraQuien={[
    { texto: 'Empresas que aún no han implementado la facturación electrónica y necesitan cumplir el mandato normativo.' },
    { texto: 'Compañías que ya emiten facturación electrónica pero enfrentan rechazos frecuentes o problemas operativos.' },
    { texto: 'Negocios que requieren integración entre su ERP, plataforma e-commerce y la DIAN.' },
    { texto: 'Empresas con alto volumen de facturación que necesitan automatización para evitar errores y sobrecostos.' },
  ]}
  enfoque={[]}
  enfoqueBar={{ human: 'Human Expertise 40%', tech: 'Tech Automation 60%' }}
  ctaTitulo="Transforme su facturación en una ventaja operativa"
  ctaDescripcion="Implementemos una solución robusta que cumpla la norma y optimice su ciclo comercial de principio a fin."
  ctaBtnPrimario="Solicitar implementación"
  ctaBtnSecundario="Hablar con un asesor"
