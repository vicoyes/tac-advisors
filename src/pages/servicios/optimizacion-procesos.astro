---
import ServicioDetailLayout from '../../layouts/ServicioDetailLayout.astro';
---

<ServicioDetailLayout
  titulo="Optimización"
  tituloItalico="de Procesos."
  subtitulo="Optimización de Procesos Financieros y Administrativos"
  badgeLabel="Process Excellence // V2.0"
  descripcionCorta="Eficiencia que se mide en resultados, no en horas. Evaluamos, rediseñamos e implementamos optimizaciones en sus procesos clave para liberar tiempo y recursos."
  imagen="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=700&h=500&fit=crop&q=80"
  imgAlt="Workflow digital y optimización de procesos empresariales en entorno moderno"
  color="primary"
  heroQuote={{
    label: 'CORE_VALUE_PROPOSITION',
    text: 'Cada hora que su equipo invierte en procesos obsoletos es una hora que no invierte en hacer crecer su negocio.',
  }}
  intro="Los procesos financieros y administrativos mal diseñados son un lastre invisible que consume recursos, genera errores y frena el crecimiento. Evaluamos, rediseñamos e implementamos optimizaciones que eliminan ineficiencias y liberan tiempo para actividades de mayor valor."
  enQueConsiste={[
    'Nuestro enfoque es práctico y medido: no recomendamos cambios por teoría, sino por datos. Cada optimización se fundamenta en diagnóstico, se justifica en proyección de ahorro y se valida con indicadores de seguimiento.',
    'Trabajamos en los procesos de contabilidad, tesorería, facturación, gestión de cartera y ciclo de compras, asegurando que cada mejora sea sostenible y escalable.',
  ]}
  queIncluye={[
    { titulo: 'Diagnóstico de procesos actuales', descripcion: 'Mapeo detallado de flujos de trabajo, identificación de cuellos de botella y puntos de error.' },
    { titulo: 'Rediseño de procesos clave', descripcion: 'Reingeniería de procesos críticos para eliminar fricción y reducir ciclo de tiempo operativa.' },
    { titulo: 'Automatización de tareas repetitivas', descripcion: 'Implementación de automatizaciones en procesos de registro, validación, notificación y reporte.' },
    { titulo: 'Implementación de herramientas digitales', descripcion: 'Selección y despliegue de software y plataformas que soportan los procesos optimizados.' },
    { titulo: 'Capacitación y transferencia', descripcion: 'Formación práctica para su equipo en los nuevos procesos y herramientas, asegurando autonomía.' },
    { titulo: 'Indicadores de gestión y seguimiento', descripcion: 'Tableros de control con métricas de eficiencia operativa para monitorear el impacto de las optimizaciones.' },
  ]}
  beneficios={[
    { titulo: 'Reducción medible de costos operativos', descripcion: 'Eficiencia que se traduce en ahorro de tiempo, recursos y costos directos de operación financiera.' },
    { titulo: 'Menos errores y reprocesos', descripcion: 'Procesos bien diseñados que reducen la probabilidad de errores humanos y la necesidad de correcciones.' },
    { titulo: 'Más tiempo para trabajo estratégico', descripcion: 'Liberación de capacidad de su equipo para análisis, planificación y decisiones, no en tareas mecánicas.' },
    { titulo: 'Escalabilidad operativa', descripcion: 'Procesos que pueden absorber crecimiento sin requerir aumentos proporcionales de personal o recursos.' },
  ]}
  paraQuien={[
    { texto: 'Empresas cuyo cierre contable toma demasiado tiempo y genera estrés operativo cada período.' },
    { texto: 'Compañías con alto volumen de transacciones que necesitan sistematizar procesos para mantener calidad.' },
    { texto: 'Negocios en crecimiento que están topando con ineficiencias que limitan su capacidad de escalar.' },
    { texto: 'Organizaciones con equipos sobrecargados de trabajo manual que podrían automatizarse.' },
  ]}
  enfoque={[]}
  enfoqueBar={{ human: 'Human Expertise 45%', tech: 'Tech Automation 55%' }}
  ctaTitulo="Encuentre las optimizaciones que generarán el mayor impacto"
  ctaDescripcion="Diagnostiquemos juntos sus procesos y descubramos las mejoras que transformarán su eficiencia operativa de forma medible."
  ctaBtnPrimario="Solicitar diagnóstico"
  ctaBtnSecundario="Hablar con un asesor"
/>
