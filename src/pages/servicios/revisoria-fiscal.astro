---
import ServicioDetailLayout from '../../layouts/ServicioDetailLayout.astro';
---

<ServicioDetailLayout
  titulo="Revisoría"
  tituloItalico="Fiscal."
  subtitulo="Función de Revisoría Fiscal"
  badgeLabel="Fiscal Control // V2.0"
  descripcionCorta="Control independiente que protege su empresa y sus stakeholders. Actuamos con rigor técnico, imparcialidad absoluta y un enfoque que genera valor más allá de la certificación."
  imagen="https://images.unsplash.com/photo-1507679799987-c73779587ccf?w=700&h=500&fit=crop&q=80"
  imgAlt="Auditor fiscal revisando documentación en ambiente de control y cumplimiento"
  color="accent"
  heroQuote={{
    label: 'CORE_VALUE_PROPOSITION',
    text: 'La revisoría fiscal no es un costo: es un mecanismo de protección que fortalece la confianza de todos los que confían en su empresa.',
  }}
  intro="La revisoría fiscal es mucho más que un requisito legal para ciertas empresas: es un mecanismo de control que protege a propietarios, inversionistas, entidades financieras y terceros que confían en la información financiera de su organización."
  enQueConsiste={[
    'Nuestro trabajo incluye la verificación de la calidad de sus estados financieros, la evaluación del cumplimiento de obligaciones tributarias y laborales, la identificación de riesgos de control y la emisión de informes con observaciones constructivas.',
    'Actuamos como revisores fiscales independientes con rigor técnico e imparcialidad absoluta, deliverando un control que va más allá de la simple certificación de cumplimiento.',
  ]}
  queIncluye={[
    { titulo: 'Certificación de estados financieros', descripcion: 'Verificación y certificación de estados financieros bajo normas de revisoría fiscal con responsabilidad legal.' },
    { titulo: 'Vigilancia del cumplimiento tributario', descripcion: 'Revisión del cumplimiento de obligaciones formales y sustanciales ante la DIAN con alertas sobre riesgos.' },
    { titulo: 'Verificación de obligaciones laborales', descripcion: 'Evaluación de pagos, liquidaciones y declaraciones relacionadas con seguridad social y parafiscales.' },
    { titulo: 'Evaluación de control interno', descripcion: 'Análisis de sistemas y procedimientos de control interno con recomendaciones para fortalecer la gestión.' },
    { titulo: 'Informe de vigilancia especial', descripcion: 'Documentación periódica con observaciones, hallazgos y recomendaciones dirigidas a junta de socios.' },
    { titulo: 'Atención a requerimientos y fiscalizaciones', descripcion: 'Representación y acompañamiento ante la DIAN o entidades de control en casos de requête o visita.' },
  ]}
  beneficios={[
    { titulo: 'Información financiera certificada', descripcion: 'Estados financieros con el sello de un revisor fiscal independiente que genera credibilidad ante terceros.' },
    { titulo: 'Detección temprana de riesgos', descripcion: 'Identificación de problemas de cumplimiento o control antes de que se conviertan en sanciones.' },
    { titulo: 'Cumplimiento legal garantizado', descripcion: 'Vigilancia permanente que asegura que su empresa cumple con los requisitos de la ley para empresas obligadas.' },
    { titulo: 'Paz mental para la administración', descripcion: 'Independencia y rigor técnico que permite a directivos tomar decisiones con tranquilidad.' },
  ]}
  paraQuien={[
    { texto: 'Empresas que por ley requieren Revisor Fiscal (sociedades anónimas, empresas del sector financiero, etc.).' },
    { texto: 'Compañías que buscan un control independiente adicional sobre su información financiera y procesos.' },
    { texto: 'Negocios con inversionistas o socios que requieren verificación externa de la gestión y los estados financieros.' },
    { texto: 'Empresas que han enfrentado problemas con autoridades fiscales o laborales y necesitan fortalecer su cumplimiento.' },
  ]}
  enfoque={[]}
  enfoqueBar={{ human: 'Human Expertise 75%', tech: 'Tech Automation 25%' }}
  ctaTitulo="Fortalezca la gestión y proteja a todos sus stakeholders"
  ctaDescripcion="Designemos juntos un esquema de revisoría que no solo cumpla la norma, sino que fortalezca la gestión de su empresa."
  ctaBtnPrimario="Solicitar revisoría fiscal"
  ctaBtnSecundario="Hablar con un asesor"
/>
